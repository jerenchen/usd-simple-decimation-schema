#usda 1.0
(
    startTimeCode = 1
    endTimeCode = 48
)

def "horse" (
    prepend references = @./horse-gallop.usd@
)
{
    # Override 'Mesh' with SimpleDecimateAPI
    over "defaultobject" (
        prepend apiSchemas = ["SimpleDecimateAPI"]
    )
    {
        int simpleDecimate:maxTriangles = 2500
        bool simpleDecimate:blockIntersections = true
    }
}
